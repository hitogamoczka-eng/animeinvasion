end
local function bind(host, method, options, setter)
    local flag, default = options.Flag, options.Default
    local function apply(value)
        if options.Kind == 'key' then
            if typeof(value) ~= 'EnumItem' or value.EnumType ~= Enum.KeyCode then return false end
        else
            if type(value) ~= type(default) then return false end
            if type(value) == 'number' then
                if value ~= value or math.abs(value) == math.huge then return false end
                value = math.clamp(value, options.Min or -math.huge, options.Max or math.huge)
            end
        end
        Values[flag] = value
        setter(value)
        if options.SaveOnChange ~= false then scheduleSave() end
        return true
    end
    apply(default)
    options.Callback = apply
    Setters[flag] = apply
    Elements[flag] = host[method](host, options)
    return Elements[flag]
end
local function applyFlag(flag, value)
    local setter = Setters[flag]
    if not setter or not setter(value) then return false end
    local element = Elements[flag]
    if element then pcall(function() element:Set(Values[flag], true) end) end
    return true
end
local function loadConfig(name)
    local ok, data = pcall(function()
        return HttpService:JSONDecode(readfile(configPath(name)))
    end)
    if not ok or type(data) ~= 'table' then return false end
    Runtime.LoadingConfig = true
    local applied = 0
    for flag, value in pairs(data) do
        if Setters[flag] then
            local good, accepted = pcall(applyFlag, flag, decodeValue(value))
            if good and accepted then applied = applied + 1 end
        end
    end
    Runtime.LoadingConfig = false
    writeBoot()
    return true, applied
end
