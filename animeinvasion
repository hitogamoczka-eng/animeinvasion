local Values, Elements, Setters = {}, {}, {}
local function bind(tab, method, options, setter)
    local flag, default = options.Flag, options.Default
    local function apply(value)
        if type(value) ~= type(default) then return false end
        if type(value) == 'number' then
            if value ~= value or math.abs(value) == math.huge then return false end
            value = math.clamp(value, options.Min or -math.huge, options.Max or math.huge)
        end
        Values[flag] = value
        setter(value)
        return true
    end
    apply(default)
    options.Callback = apply
    Setters[flag] = apply
    Elements[flag] = tab[method](tab, options)
    return Elements[flag]
end
local function applyFlag(flag, value)
    local setter = Setters[flag]
    if not setter or not setter(value) then return false end
    Elements[flag]:Set(Values[flag], true)
    return true
end
local function configPath(name)
    assert(type(name) == 'string' and #name > 0 and #name <= 64, 'Invalid config name')
    assert(not name:find('/', 1, true) and not name:find('\\', 1, true)
        and not name:find('..', 1, true), 'Invalid config name')
    return CONFIG_FOLDER .. '/' .. name .. '.json'
end
local function saveConfig(name)
    local ok, err = pcall(function()
        writefile(configPath(name), HttpService:JSONEncode(Values))
        writefile(BOOT_FILE, HttpService:JSONEncode(AUTO))
    end)
    if not ok then warn('[vector] SaveConfig:', err) end
    return ok
end
local function loadConfig(name)
    local ok, data = pcall(function()
        return HttpService:JSONDecode(readfile(configPath(name)))
    end)
    if not ok or type(data) ~= 'table' then return false end
    local applied = 0
    for flag, value in pairs(data) do
        if Setters[flag] then
            local good, accepted = pcall(applyFlag, flag, value)
            if good and accepted then applied = applied + 1 end
        end
    end
    print(('[vector] Config loaded: %s; applied=%d'):format(name, applied))
    return true
end

