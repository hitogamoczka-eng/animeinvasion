local function responseError(response)
    if type(response) == 'table' then
        return tostring(response.reason or response.message or response.error or 'Запрос отклонён')
    end
    return tostring(response)
end
local function acceptState(state)
    if type(state) ~= 'table' or type(state.candy) ~= 'number'
        or type(state.stock) ~= 'table' or type(state.stock.capsule) ~= 'number' then
        return false
    end
    Runtime.Shop = state
    return true
end
local function refreshShop()
    Runtime.NextState = os.clock() + 10
    local ok, response = pcall(function() return HalloweenShop:InvokeServer('state') end)
    if not Runtime.Alive then return false end
    if ok and type(response) == 'table' and response.ok and acceptState(response.state) then
        return true
    end
    Runtime.Shop = nil
    Runtime.Note = 'Ошибка магазина: ' .. responseError(response)
    return false
end
local function capsuleStep()
    local state = Runtime.Shop
    local resetDue = state and type(state.resetAt) == 'number'
        and workspace:GetServerTimeNow() >= state.resetAt
    if os.clock() >= Runtime.NextState then
        if not refreshShop() then return end
    elseif resetDue then
        Runtime.Note = 'Ожидание обновления магазина'
        return
    end
    if not Runtime.Alive or not Runtime.AutoCapsule then return end
    state = Runtime.Shop
    if not state then return end
    if state.stock.capsule <= 0 then
        Runtime.Note = 'Нет в наличии — жду обновления магазина'
        return
    end
    if state.candy < offer.price then
        Runtime.Note = 'Недостаточно конфет — жду пополнения'
        return
    end
    if os.clock() < Runtime.NextBuy then return end
    Runtime.NextBuy = os.clock() + CONFIG.CapsuleInterval
    local ok, response = pcall(function()
        return HalloweenShop:InvokeServer('buy', 'capsule')
    end)
    if not Runtime.Alive then return end
    local hasState = type(response) == 'table' and acceptState(response.state)
    if not hasState then
        Runtime.Shop = nil
        Runtime.NextState = 0
    end
    if ok and type(response) == 'table' and response.ok then
        Runtime.Bought = Runtime.Bought + (tonumber(offer.amount) or 1)
        Runtime.Note = 'Halloween Capsule куплена'
    else
        Runtime.Note = 'Покупка отклонена: ' .. responseError(response)
        Runtime.NextBuy = os.clock() + math.max(10, CONFIG.CapsuleInterval)
    end
end
local function refreshHalloweenStatus()
