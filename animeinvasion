local function refreshPotionStatus()
    local counts = potionCounts()
    local lines = {}
    local now = os.clock()
    local serverNow = workspace:GetServerTimeNow()
    for _, definition in ipairs(POTIONS) do
        local timer = potionTimers[definition.Id]
        local amount = counts[definition.Id]
        local effectRemaining = math.max(0, (tonumber(player:GetAttribute(definition.EndsAttribute)) or 0) - serverNow)
        local nextUse = 'выключено'
        if Runtime[definition.Flag] then
            nextUse = timer.NextAt > now and ('через ' .. formatTime(timer.NextAt - now)) or 'сейчас'
        end
        lines[#lines + 1] = ('%s | Запас: %s | Эффект: %s\nСледующее: %s | Выпито: %d\n%s'):format(
            definition.Title,
            amount ~= nil and tostring(amount) or '-',
            formatTime(effectRemaining),
            nextUse,
            tonumber(timer.Used) or 0,
            tostring(timer.Note)
        )
    end
    lines[#lines + 1] = 'Общий множитель удачи: x' .. tostring(player:GetAttribute('LuckMultiplier') or 1)
    setParagraph(potionStatus, 'Status', table.concat(lines, '\n\n'))
end

local function usePotion(definition, timer)
    if not Runtime.Alive or not Runtime[definition.Flag] or os.clock() < timer.NextAt then return end
    local remote = Remotes:FindFirstChild('UseItem')
    if not remote or not remote:IsA('RemoteFunction') then
        timer.Note = 'UseItem недоступен; повтор через 30 секунд'
        timer.NextAt = os.clock() + CONFIG.PotionRetryDelay
        return
    end

    -- Reserve the interval before yielding so a reload cannot immediately duplicate this request.
    timer.NextAt = os.clock() + CONFIG.PotionInterval
    timer.Note = 'Отправлен запрос использования...'
    local ok, response = pcall(function()
        return remote:InvokeServer(definition.Id)
    end)
    if not Runtime.Alive then return end

    local accepted = ok and (response == true or (type(response) == 'table' and response.ok == true))
    local rejected = ok and (response == false or (type(response) == 'table' and response.ok == false))
    if accepted then
        timer.LastSuccess = os.clock()
        timer.NextAt = timer.LastSuccess + CONFIG.PotionInterval
        timer.Used = (tonumber(timer.Used) or 0) + 1
        timer.Note = 'Использование подтверждено сервером'
        notify(definition.Title, 'Использовано. Следующее через 8 минут.', 3)
    elseif rejected then
        timer.Note = ('Сервер отказал: %s; повтор через 30 секунд'):format(responseError(response))
        timer.NextAt = os.clock() + CONFIG.PotionRetryDelay
        warn('[vector] ' .. definition.Title .. ': ' .. timer.Note)
    else
        -- A failed/unknown reply is not proof of rejection; avoid consuming another potion immediately.
        timer.Note = 'Использование не подтверждено: ' .. responseError(response):sub(1, 180)
        warn('[vector] ' .. definition.Title .. ': ' .. timer.Note)
    end
end

