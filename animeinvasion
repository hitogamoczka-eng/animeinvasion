spawnTask(function()
    while Runtime.Alive do
        local ok, err = pcall(capsuleStep)
        if not ok then
            Runtime.Note = 'Ошибка: ' .. tostring(err)
            Runtime.Shop = nil
            Runtime.NextState = os.clock() + 10
            Runtime.NextBuy = os.clock() + 10
        end
        task.wait(0.25)
    end
end)
spawnTask(function()
    while Runtime.Alive do
        for _, definition in ipairs(POTIONS) do
            if not Runtime.Alive then break end
            local timer = potionTimers[definition.Id]
            if Runtime[definition.Flag] and os.clock() >= timer.NextAt then
                local ok, err = pcall(usePotion, definition, timer)
                if not ok then
                    timer.Note = 'Ошибка: ' .. tostring(err)
                    timer.NextAt = math.max(timer.NextAt, os.clock() + CONFIG.PotionRetryDelay)
                    warn('[vector] ' .. definition.Title .. ': ' .. timer.Note)
                end
                task.wait(1)
            end
        end
        task.wait(0.25)
    end
end)
spawnTask(function()
    local lastSave = os.clock()
    while Runtime.Alive do
        if AUTO.SaveEnabled and os.clock() - lastSave >= AUTO.SaveInterval then
            saveConfig(AUTO.ConfigName)
            lastSave = os.clock()
        end
        task.wait(1)
    end
end)
