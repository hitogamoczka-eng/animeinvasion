local Values, Elements, Setters = {}, {}, {}
local function encodeValue(v)
    if typeof(v) == 'Color3' then return {__t = 'Color3', r = v.R, g = v.G, b = v.B} end
    if typeof(v) == 'EnumItem' then return {__t = 'Enum', e = tostring(v.EnumType), n = v.Name} end
    return v
end
local function decodeValue(v)
    if type(v) == 'table' then
        if v.__t == 'Color3' then return Color3.new(v.r, v.g, v.b) end
        if v.__t == 'Enum' then
            local ok, key = pcall(function() return Enum[v.e][v.n] end)
            if ok then return key end
        end
    end
    return v
end
local function configPath(name)
    assert(type(name) == 'string' and #name > 0 and #name <= 64, 'Invalid config name')
    assert(not name:find('/', 1, true) and not name:find('\\', 1, true)
        and not name:find('..', 1, true), 'Invalid config name')
    return CONFIG_FOLDER .. '/' .. name .. '.json'
end
local function writeBoot()
    pcall(writefile, BOOT_FILE, HttpService:JSONEncode(AUTO))
end
local function saveConfig(name)
    local ok, err = pcall(function()
        ensureFolders()
        local data = {}
        for k, v in pairs(Values) do data[k] = encodeValue(v) end
        writefile(configPath(name), HttpService:JSONEncode(data))
        writeBoot()
    end)
    if not ok then warn('[vector] SaveConfig:', err) end
    return ok
end
local function scheduleSave()
    if not Runtime.Alive or not Runtime.Ready or Runtime.LoadingConfig then return end
    if Runtime.SaveQueued then return end
    Runtime.SaveQueued = true
    task.delay(0.35, function()
        if not Runtime.Alive then return end
        Runtime.SaveQueued = false
        saveConfig(AUTO.ConfigName)
    end)
end
local function spawnTask(fn)
    local thread = task.spawn(function()
        local ok, err = pcall(fn)
        if not ok and Runtime.Alive then warn('[vector]', err) end
    end)
    table.insert(Runtime.Tasks, thread)
    return thread
end
local notifyState
local function notify(title, text, duration)
    if not Runtime.Alive then return end
    if notifyState ~= false then
        local ok = pcall(function()
            if NextUI:Notify({Title = title, Content = text, Duration = duration or 3}) then
                notifyState = true
                return
            end
            error('notify unavailable')
        end)
        if ok and notifyState == true then return end
        notifyState = false
    end
    pcall(function()
        StarterGui:SetCore('SendNotification', {
            Title = title, Text = text, Duration = duration or 3,
        })
    end)
end
local function setParagraph(element, title, content)
