end
local potionTimers = timerStore.Entries
for _, definition in ipairs(POTIONS) do
    local timer = potionTimers[definition.Id]
    if type(timer) ~= 'table' or type(timer.NextAt) ~= 'number' then
        potionTimers[definition.Id] = {
            NextAt = 0,
            LastSuccess = 0,
            Used = 0,
            Note = 'Готово к первому использованию',
        }
    end
end
Runtime.PotionTimers = potionTimers
Runtime.PotionInterval = CONFIG.PotionInterval

-- The profile is only used for the display. Missing inventory UI/data never blocks a request.
local potionProfile
local function potionCounts()
    if not potionProfile then
        local modules = RS:FindFirstChild('Modules')
        local ui = modules and modules:FindFirstChild('UI')
        local module = ui and ui:FindFirstChild('ProfileClient')
        if module then
            local ok, value = pcall(require, module)
            if ok and type(value) == 'table' then potionProfile = value end
        end
    end
    if potionProfile and type(potionProfile.fusionItems) == 'function' then
        local ok, items = pcall(potionProfile.fusionItems)
        if ok and type(items) == 'table' then
            return {
                lucky_potion = tonumber(items.lucky_potion) or 0,
                super_lucky_potion = tonumber(items.super_lucky_potion) or 0,
            }
        end
    end
    return {}
end
local function formatTime(seconds)
    seconds = math.max(0, math.ceil(tonumber(seconds) or 0))
    return string.format('%d:%02d', seconds // 60, seconds % 60)
end

