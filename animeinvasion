    while Runtime.Alive do
        task.wait(0.5)
        local themeName = NextUI.ThemeName
        if type(themeName) == 'string' and themeName ~= Values.UITheme then
            Values.UITheme = themeName
            AUTO.Theme = themeName
            local element = Elements.UITheme
            if element then pcall(function() element:Set(themeName, true) end) end
            scheduleSave()
        end
        local keyElement = Elements.UIMenuKey
        if keyElement then
            local key = keyElement:Get()
            if typeof(key) == 'EnumItem' and key ~= Values.UIMenuKey then
                Values.UIMenuKey = key
                AUTO.MenuKey = key.Name
                scheduleSave()
            end
        end
    end
end)
