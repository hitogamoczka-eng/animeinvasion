-- Use a compiled cache instead of deleting an arbitrary source line.
local function compileNextUI()
    local cache = 'NextUI/vector_halloween/nextui-cache.lua'
    local ok, source = pcall(function()
        return game:HttpGet('https://diser.me/nextui/source.lua')
    end)
    local reason = source
    if ok and type(source) == 'string' then
        local fn, err = loadstring(source, 'NextUI')
        if fn then
            pcall(writefile, cache, source)
            return fn
        end
        reason = err
    end
    local cachedOK, cached = pcall(readfile, cache)
    if cachedOK then
        local fn = loadstring(cached, 'NextUI-cache')
        if fn then return fn end
    end
    error('[vector] Не удалось загрузить NextUI: ' .. tostring(reason), 0)
end

