local function getPotionInfo()
    local ends = player:GetAttribute("LuckPotionEnds") or 0
    local remaining = math.max(0, ends - os.time())
    local mult = player:GetAttribute("LuckMultiplier") or 1
    local counts = { lucky = 0, super = 0 }
    pcall(function()
        local ui = player.PlayerGui:FindFirstChild("ui"); if not ui then return end
        local inv = ui:FindFirstChild("inv"); if not inv then return end
        local sf = inv:FindFirstChild("inner part")
        sf = sf and sf:FindFirstChild("inv")
        sf = sf and sf:FindFirstChild("ScrollingFrame")
        if not sf then return end
        for key, name in pairs({ lucky = "lucky_potion", super = "super_lucky_potion" }) do
            local pot = sf:FindFirstChild(name)
            if pot then
                local inner = pot:FindFirstChild("trait rr")
                inner = inner and inner:FindFirstChild("outer")
                inner = inner and inner:FindFirstChild("inner")
                local amt = inner and inner:FindFirstChild("amount")
                if amt then counts[key] = tonumber((amt.Text:gsub("x", ""))) or 0 end
            end
        end
    end)
    return remaining, mult, counts
end

