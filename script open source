-- vector | NextUI (правильный API + патч битого source.lua + фикс загрузки)
local NextUI
do
    local src = game:HttpGet("https://diser.me/nextui/source.lua")
    local fn = loadstring(src)
    if not fn then
        local lines = {}
        for line in (src .. "\n"):gmatch("([^\n]*)\n") do
            table.insert(lines, line)
        end
        table.remove(lines, 4300)
        fn = loadstring(table.concat(lines, "\n"))
    end
    if not fn then
        error("[vector] Не удалось загрузить NextUI — файл по ссылке повреждён")
    end
    NextUI = fn()
end

