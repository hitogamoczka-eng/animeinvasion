-- ===== BUY LOGIC =====
local function rarityWanted(rar)
    if not rar then return false end
    if CONFIG.TargetRarities[rar] then return true end
    local lower = string.lower(rar)
    for k, v in pairs(CONFIG.TargetRarities) do
        if v and string.lower(k) == lower then return true end
    end
    return false
end

local function buyCard(card)
    local bp = card:FindFirstChild("BuyPrompt")
    if not bp then return false end
    teleportTo(card.Position)
    local tries = 0
    while card.Parent and tries < 15 do
        if bp.Enabled then
            pcall(function() fireproximityprompt(bp) end)
            task.wait(0.35)
            if not card.Parent then return true end
        end
        tries = tries + 1
        task.wait(0.1)
    end
    return card.Parent == nil
end

local function processCards()
    local pl = workspace:FindFirstChild("PlacedCards")
    if not pl then return 0 end
    local snap = {}
    for _, c in ipairs(pl:GetChildren()) do
        if c:IsA("BasePart") and isMyCard(c) then snap[#snap+1] = c end
    end
    local bought = 0
    local notes = {}
    for _, card in ipairs(snap) do
        if card.Parent then
            local rar = getCardRarity(card)
            local price = getCardPrice(card)
            local buy = false
            if rarityWanted(rar) then buy = true
            elseif CONFIG.UsePriceFallback and price and price >= CONFIG.MinPrice then buy = true end
            if buy then
                if buyCard(card) then
                    bought = bought + 1
                    table.insert(notes, (rar or "?") .. " (Bought)")
                    print("[vector] BOUGHT:", rar or "?", price or "?")
                else
                    table.insert(notes, (rar or "?") .. " (Fail)")
                end
            else
                table.insert(notes, (rar or "?") .. " (Skip)")
            end
        end
    end
    if #notes > 0 then lastNote = table.concat(notes, ", ") end
    return bought
end

local function loop()
    if busy then return end
    busy = true
    while running do
        local ok, err = pcall(function()
            local plot = getMyPlot()
            if not plot then task.wait(2); return end
            local prompt = findPrompt(plot, "SummonPrompt")
            if not prompt then task.wait(2); return end

            buyCount = buyCount + processCards()
            if not running then return end

            local spinBefore = plot:GetAttribute("SpinCount") or 0
            rollAttempts = rollAttempts + 1

            local waitReady = 0
            while running and (not prompt.Enabled or (plot:GetAttribute("RollPhase") or "Idle") ~= "Idle") and waitReady < 10 do
                task.wait(0.2); waitReady = waitReady + 0.2
            end

            teleportTo(prompt.Parent.Position)
            firePrompt(prompt)

            local rollAccepted = false
            local deadline = os.clock() + CONFIG.AfterRollWait + 5
            while os.clock() < deadline and running do
                if (plot:GetAttribute("SpinCount") or 0) ~= spinBefore then rollAccepted = true; break end
                task.wait(0.1)
            end

            if not rollAccepted then
                emptyStreak = emptyStreak + 1
                lastNote = "Roll timeout"
                if emptyStreak >= CONFIG.MaxRollsWithoutCards then task.wait(2); emptyStreak = 0 end
                return
            end

            local animDeadline = os.clock() + 8
            while os.clock() < animDeadline and running do
                if (plot:GetAttribute("RollPhase") or "Idle") == "Idle" then break end
                task.wait(0.1)
            end
            task.wait(0.3)

            rollSuccess = rollSuccess + 1
            emptyStreak = 0
            buyCount = buyCount + processCards()
            task.wait(CONFIG.RollDelay)
        end)
        if not ok then warn("[vector]", err); task.wait(1) end
    end
    busy = false
end

