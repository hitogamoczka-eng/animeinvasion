    while Runtime.Alive do
        local ok, err = pcall(capsuleStep)
        if not ok then
            Runtime.Note = 'Ошибка: ' .. tostring(err)
            Runtime.Shop = nil
            Runtime.NextState = os.clock() + 10
            Runtime.NextBuy = os.clock() + 10
        end
        task.wait(0.25)
    end
end)
spawnTask(function()
    while Runtime.Alive do
        if (Runtime.AutoPotion or Runtime.AutoSuper) and os.clock() >= Runtime.NextPotion then
            Runtime.NextPotion = os.clock() + CONFIG.PotionCheckInterval
            local ok, err = pcall(function()
                local remaining, _, counts = getPotionInfo()
                if Runtime.Alive and Runtime.AutoPotion and counts.lucky > 0 and remaining < CONFIG.PotionThreshold then
                    usePotion('lucky_potion', 'Potion')
                end
                remaining, _, counts = getPotionInfo()
                if Runtime.Alive and Runtime.AutoSuper and counts.super > 0 and remaining < CONFIG.SuperThreshold then
                    usePotion('super_lucky_potion', 'Super Potion')
                end
            end)
            if not ok then warn('[vector] Potions:', err) end
        end
        task.wait(0.5)
    end
end)
