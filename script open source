local function stop()
    if not Runtime.Alive then return end
    Runtime.Alive = false
    for _, connection in ipairs(Runtime.Connections) do
        pcall(function() connection:Disconnect() end)
    end
    for _, thread in ipairs(Runtime.Tasks) do
        if thread ~= coroutine.running() then pcall(task.cancel, thread) end
    end
    if NextUI then pcall(function() NextUI:Destroy() end) end
    if env.__vector_halloween == Runtime then env.__vector_halloween = nil end
end
