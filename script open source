-- ===== HELPERS =====
local function getMyPlot()
    local pf = workspace:FindFirstChild("New plots")
    if not pf then return nil end
    for _, p in ipairs(pf:GetChildren()) do
        if p:GetAttribute("OwnerUserId") == player.UserId then return p end
    end
    return nil
end

local function findPrompt(plot, name)
    if not plot then return nil end
    local roll = plot:FindFirstChild("ROLL")
    local btn = roll and roll:FindFirstChild("Button")
    return btn and btn:FindFirstChild(name)
end

local function firePrompt(prompt)
    if not prompt or not prompt.Enabled then return false end
    local ok = pcall(fireproximityprompt, prompt)
    if ok then return true end
    local a = pcall(function() firesignal(PP.PromptButtonHoldBegan, prompt, player) end)
    task.wait((prompt.HoldDuration or 0.2) + CONFIG.HoldExtra)
    local b = pcall(function() firesignal(PP.PromptTriggered, prompt, player) end)
    return a and b
end

local function isMyCard(c)
    return tonumber(c:GetAttribute("OwnerUserId")) == player.UserId
end

local function getCardRarity(c)
    local l = c:FindFirstChild("rarity", true)
    if not l or not l:IsA("TextLabel") then return nil end
    local t = l.Text:gsub("^%s+", ""):gsub("%s+$", "")
    t = t:gsub("(%a)([%w]*)", function(a, b) return a:upper() .. b:lower() end)
    return t
end

local function getCardPrice(c)
    local p = c:FindFirstChild("BuyPrompt")
    if not p then return nil end
    return tonumber((p.ActionText:gsub("Buy %$", ""):gsub(",", "")))
end

local function teleportTo(pos)
    local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    if (hrp.Position - pos).Magnitude > CONFIG.TeleportThreshold then
        hrp.CFrame = CFrame.new(pos + CONFIG.TeleportOffset)
        task.wait(0.25)
    end
end

