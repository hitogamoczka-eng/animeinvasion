-- ===== CONFIG MANAGER (исправленный) =====
local CONFIG_FOLDER = "NextUI/configs"
local function ensureConfigFolder()
    if makefolder and not isfolder("NextUI") then makefolder("NextUI") end
    if makefolder and not isfolder(CONFIG_FOLDER) then makefolder(CONFIG_FOLDER) end
end
local function configPath(name) return CONFIG_FOLDER .. "/" .. name .. ".json" end

local function SaveConfig(name)
    ensureConfigFolder()
    local data = {}
    for flag, value in pairs(NextUI.Flags or {}) do
        -- пропускаем служебные *_enabled
        if not flag:find("_enabled$") then
            data[flag] = value
        end
    end
    local ok, json = pcall(function() return HttpService:JSONEncode(data) end)
    if not ok then
        warn("[vector] SaveConfig JSONEncode failed:", json)
        return false
    end
    local wok, werr = pcall(writefile, configPath(name), json)
    if not wok then
        warn("[vector] writefile failed:", werr)
        return false
    end
    print("[vector] Config saved to", configPath(name), "(" .. #json .. " bytes)")
    return true
end

local function LoadConfig(name)
    local path = configPath(name)
    if not (isfile and isfile(path)) then
        print("[vector] Config not found:", path)
        return false
    end
    local rok, content = pcall(readfile, path)
    if not rok then
        warn("[vector] readfile failed:", content)
        return false
    end
    local dok, data = pcall(function() return HttpService:JSONDecode(content) end)
    if not dok then
        warn("[vector] JSONDecode failed:", data)
        return false
    end
    local applied, missing = 0, 0
    for flag, value in pairs(data) do
        -- сначала пробуем через элемент
        local el = Elements[flag]
        if el and el.Set then
            local ok2 = pcall(function() el:Set(value) end)
            if ok2 then
                applied = applied + 1
            else
                missing = missing + 1
            end
        elseif NextUI.Flags and NextUI.Flags[flag] ~= nil then
            -- fallback: пишем напрямую в Flags (для Textbox)
            NextUI.Flags[flag] = value
            applied = applied + 1
        else
            missing = missing + 1
        end
    end
    -- ФИКС: синхронизируем локальные переменные, потому что Set() на Textbox не триггерит Callback
    if data.CfgNameBox then configName = data.CfgNameBox end
    if data.AutoCfgName then AUTO.ConfigName = data.AutoCfgName end
    if data.ScriptUrl then AUTO.ScriptUrl = data.ScriptUrl end
    if data.AutoSave ~= nil then AUTO.SaveEnabled = data.AutoSave end
    if data.AutoLoad ~= nil then AUTO.LoadEnabled = data.AutoLoad end
    if data.AutoReconnect ~= nil then AUTO.ReconnectEnabled = data.AutoReconnect end
    if data.DelayAfterRoll then CONFIG.RollDelay = data.DelayAfterRoll end
    if data.WaitForCards then CONFIG.AfterRollWait = data.WaitForCards end
    if data.PriceFallback ~= nil then CONFIG.UsePriceFallback = data.PriceFallback end
    if data.MinPrice then CONFIG.MinPrice = data.MinPrice end
    -- Rarity флаги
    for _, r in ipairs(RARITY_ORDER) do
        local key = "Rarity_" .. r
        if data[key] ~= nil then
            CONFIG.TargetRarities[r] = data[key]
        end
    end
    -- AutoRoll: синхронизируем состояние и запускаем loop если был включён
    if data.AutoRoll ~= nil then
        running = data.AutoRoll
        if data.AutoRoll then task.spawn(loop) end
    end
    if data.AutoPotion ~= nil then potionRunning = data.AutoPotion end
    if data.AutoSuper ~= nil then superRunning = data.AutoSuper end
    print(("[vector] Config loaded from %s: applied=%d missing=%d"):format(path, applied, missing))
    return true
end

