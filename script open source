    setParagraph(halloweenStatus, 'Status', ('Конфеты: %s | Остаток: %s | Куплено: %d\n%s'):format(
        candy, stock, Runtime.Bought, Runtime.AutoCapsule and Runtime.Note or 'Выключено'))
end

-- ===== POTIONS =====
local function getPotionInfo()
    local ends = tonumber(player:GetAttribute('LuckPotionEnds')) or 0
    local remaining = math.max(0, math.floor(ends - os.time()))
    local multiplier = tonumber(player:GetAttribute('LuckMultiplier')) or 1
    local counts = {lucky = 0, super = 0}
    local gui = player:FindFirstChildOfClass('PlayerGui')
    local node = gui and gui:FindFirstChild('ui')
    for _, name in ipairs({'inv', 'inner part', 'inv', 'ScrollingFrame'}) do
        node = node and node:FindFirstChild(name)
    end
    if node then
        for key, id in pairs({lucky = 'lucky_potion', super = 'super_lucky_potion'}) do
            local amount = node:FindFirstChild(id)
            for _, name in ipairs({'trait rr', 'outer', 'inner', 'amount'}) do
                amount = amount and amount:FindFirstChild(name)
            end
            if amount and amount:IsA('TextLabel') then
                counts[key] = tonumber((amount.Text:gsub('[xX,%s]', ''))) or 0
            end
        end
    end
    return remaining, multiplier, counts
end
local potionStatus = PotionsTab:AddParagraph({Title = 'Status', Content = 'Time left: - | Multiplier: - | Lucky: - | Super: -'})
local function refreshPotionStatus()
    local remaining, multiplier, counts = getPotionInfo()
    setParagraph(potionStatus, 'Status', ('Time left: %d:%02d | Multiplier: x%s | Lucky: %d | Super: %d'):format(
        remaining // 60, remaining % 60, tostring(multiplier), counts.lucky, counts.super))
end
local function usePotion(id, title)
    local remote = Remotes:FindFirstChild('UseItem')
    if not remote or not remote:IsA('RemoteFunction') then return end
    local ok, response = pcall(function() return remote:InvokeServer(id) end)
    if ok and type(response) == 'table' and response.ok then notify(title, 'Used', 3) end
end
